{
  "bugs": {
    "url": "https://github.com/agorail-labs/subscription-change-quote/issues"
  },
  "description": "Release candidate: simulator-backed subscription change quotes, bounded acceptance, durable receipt replay and outcome reconciliation; not a live billing SDK",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "files": [
    "dist/src/",
    "!dist/src/live/",
    "!dist/src/integration/",
    "examples/",
    "README.md",
    "DEVELOPER-GUIDE.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/agorail-labs/subscription-change-quote#readme",
  "keywords": [
    "agentic-commerce",
    "subscription-change",
    "billing-quotes",
    "durable-replay",
    "financial-reconciliation",
    "ai-agents",
    "simulator",
    "reference-implementation"
  ],
  "license": "Apache-2.0",
  "main": "./dist/src/index.js",
  "name": "@agorail-labs/scq-reference",
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "repository": {
    "directory": "reference",
    "type": "git",
    "url": "git+https://github.com/agorail-labs/subscription-change-quote.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "demo": "npm run build && node dist/demo/seat-expansion.js",
    "demo:commit": "npm run build && node dist/demo/seat-expansion.js --simulate-approved-commit",
    "pilot:chargebee": "npm run build && node dist/src/live/pilot/run-pilot.js",
    "preflight:chargebee": "npm run build && node dist/src/live/pilot/run-preflight.js",
    "prepack": "npm run build",
    "smoke:pack": "npm run build && node scripts/smoke-pack.mjs",
    "test": "tsc -p tsconfig.json && node --test dist/tests/*.test.js"
  },
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "version": "1.0.0-rc.2",
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
